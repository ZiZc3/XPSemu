+/*
+ * XPSemu: the EEPROM's video settings. The user section (time zone,
+ * language, video, audio...) starts at 0x64, its checksum at 0x60 covers
+ * 0x5C bytes of it (eeprom_generation.c), and the video flags are at 0x94.
+ */
+#define EEPROM_USER_CHECKSUM 0x60
+#define EEPROM_USER_SECTION 0x64
+#define EEPROM_USER_CHECKED 0x5C
+#define EEPROM_VIDEO_FLAGS 0x94
+
+static SMBusStorageDevice *xemu_eeprom(void)
+{
+    Object *o = object_resolve_path_type("", TYPE_SMBUS_STORAGE, NULL);
+    SMBusStorageDevice *s = o ? SMBUS_STORAGE(o) : NULL;
+    return s && s->data && s->size >= 256 ? s : NULL;
+}
+
+static uint32_t xemu_eeprom_crc(const uint8_t *data, size_t len)
+{
+    uint32_t high = 0, low = 0;
+    for (size_t i = 0; i < len / 4; i++) {
+        uint32_t val = ldl_le_p(data + i * 4);
+        uint64_t sum = ((uint64_t)high << 32) | low;
+        high = (sum + val) >> 32;
+        low += val;
+    }
+    return ~(high + low);
+}
+
+bool xemu_eeprom_get_video_flags(uint32_t *flags)
+{
+    SMBusStorageDevice *s = xemu_eeprom();
+    if (!s) {
+        return false;
+    }
+    *flags = ldl_le_p(s->data + EEPROM_VIDEO_FLAGS);
+    return true;
+}
+
+bool xemu_eeprom_set_video_flags(uint32_t flags)
+{
+    SMBusStorageDevice *s = xemu_eeprom();
+    if (!s) {
+        return false;
+    }
+    stl_le_p(s->data + EEPROM_VIDEO_FLAGS, flags);
+    stl_le_p(s->data + EEPROM_USER_CHECKSUM,
+             xemu_eeprom_crc(s->data + EEPROM_USER_SECTION,
+                             EEPROM_USER_CHECKED));
+    if (s->file && s->persist) {
+        int fd = qemu_open(s->file, O_WRONLY | O_BINARY, NULL);
+        if (fd < 0) {
+            return false;
+        }
+        bool ok = write(fd, s->data, s->size) == (ssize_t)s->size;
+        close(fd);
+        return ok;
+    }
+    return true;
+}
