 #include "crypto/aes-round.h"
 #include "crypto/clmul.h"
 
+#if defined(__PROSPERO__) && !defined(XPS_SIMD_HELPERS)
+#define XPS_SIMD_HELPERS
+/*
+ * XPSemu: the PS5's CPU is x86 too, so some of the Xbox's MMX/SSE
+ * instructions are one host instruction instead of a loop of emulated
+ * steps (Fable spent ~10% of its CPU thread in the MMX unpack/pack loops
+ * and ~20% in emulated float math).
+ */
+#include <immintrin.h>
+
+/* MMX punpck{l,h}{bw,wd,dq}: interleave the low (or high) halves. */
+static inline void xps_mmx_unpck(void *d, const void *v, const void *s,
+                                 int high, int size)
+{
+    __m128i a = _mm_loadl_epi64((const __m128i *)v);
+    __m128i b = _mm_loadl_epi64((const __m128i *)s);
+    __m128i r = size == 8  ? _mm_unpacklo_epi8(a, b) :
+                size == 16 ? _mm_unpacklo_epi16(a, b) :
+                             _mm_unpacklo_epi32(a, b);
+    if (high) {
+        r = _mm_srli_si128(r, 8);
+    }
+    _mm_storel_epi64((__m128i *)d, r);
+}
+
+enum { XPS_PACK_sswb, XPS_PACK_uswb, XPS_PACK_ssdw };
+
+/* MMX packsswb/packuswb/packssdw: v's then s's elements, saturated. */
+static inline void xps_mmx_pack(void *d, const void *v, const void *s,
+                                int kind)
+{
+    __m128i x = _mm_unpacklo_epi64(_mm_loadl_epi64((const __m128i *)v),
+                                   _mm_loadl_epi64((const __m128i *)s));
+    __m128i r = kind == XPS_PACK_sswb ? _mm_packs_epi16(x, x) :
+                kind == XPS_PACK_uswb ? _mm_packus_epi16(x, x) :
+                                        _mm_packs_epi32(x, x);
+    _mm_storel_epi64((__m128i *)d, r);
+}
+
+enum { XPS_OP_add, XPS_OP_sub, XPS_OP_mul, XPS_OP_div, XPS_OP_min,
+       XPS_OP_max };
+
+/*
+ * SSE add/sub/mul/div ps (4 lanes) and ss (lane 0) with the host's SSE,
+ * under the same conditions as softfloat's own hardfloat path (round to
+ * nearest, inexact already raised): every input zero or normal, every
+ * result normal (or an exact zero from zero inputs). Then the host's
+ * result is bit-exact and no new flag can arise; anything else (NaN, inf,
+ * denormals, possible underflow) goes the emulated way.
+ */
+static inline bool xps_lane_ok(uint32_t x)
+{
+    uint32_t e = x & 0x7f800000;
+    return e != 0x7f800000 && (e != 0 || !(x & 0x7fffffff));
+}
+
+static inline bool xps_sse_fast(CPUX86State *env, int op, void *d,
+                                const void *v, const void *s, int lanes)
+{
+    float_status *st = &env->sse_status;
+    uint32_t a[4], b[4], r[4];
+    __m128 va, vb, vr;
+    int i;
+
+    if (op > XPS_OP_div ||
+        !(st->float_exception_flags & float_flag_inexact) ||
+        st->float_rounding_mode != float_round_nearest_even) {
+        return false;
+    }
+    va = _mm_loadu_ps((const float *)v);
+    vb = _mm_loadu_ps((const float *)s);
+    _mm_storeu_si128((__m128i *)a, _mm_castps_si128(va));
+    _mm_storeu_si128((__m128i *)b, _mm_castps_si128(vb));
+    for (i = 0; i < lanes; i++) {
+        if (!xps_lane_ok(a[i]) || !xps_lane_ok(b[i]) ||
+            (op == XPS_OP_div && !(b[i] & 0x7f800000))) {
+            return false;
+        }
+    }
+    switch (op) {
+    case XPS_OP_add: vr = _mm_add_ps(va, vb); break;
+    case XPS_OP_sub: vr = _mm_sub_ps(va, vb); break;
+    case XPS_OP_mul: vr = _mm_mul_ps(va, vb); break;
+    default:         vr = _mm_div_ps(va, vb); break;
+    }
+    _mm_storeu_si128((__m128i *)r, _mm_castps_si128(vr));
+    for (i = 0; i < lanes; i++) {
+        uint32_t m = r[i] & 0x7fffffff;
+        if ((r[i] & 0x7f800000) == 0x7f800000) {
+            return false; /* overflow */
+        }
+        if (m <= 0x00800000) { /* zero, denormal or FLT_MIN */
+            bool az = !(a[i] & 0x7fffffff), bz = !(b[i] & 0x7fffffff);
+            bool exact = m == 0 &&
+                         (op == XPS_OP_mul ? (az || bz) :
+                          op == XPS_OP_div ? az : (az && bz));
+            if (!exact) {
+                return false;
+            }
+        }
+    }
+    if (lanes == 4) {
+        _mm_storeu_ps((float *)d, vr);
+    } else {
+        uint32_t *o = d;
+        o[0] = r[0];
+        o[1] = a[1];
+        o[2] = a[2];
+        o[3] = a[3];
+    }
+    return true;
+}
