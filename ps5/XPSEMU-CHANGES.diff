diff --git a/fpu/softfloat.c b/fpu/softfloat.c
index 8094358c2e..efccf9f509 100644
--- a/fpu/softfloat.c
+++ b/fpu/softfloat.c
@@ -3365,8 +3365,46 @@ int16_t float32_to_int16(float32 a, float_status *s)
     return float32_to_int16_scalbn(a, s->float_rounding_mode, 0, s);
 }
 
+#ifdef __PROSPERO__
+#include <xmmintrin.h>
+/*
+ * XPSemu: float -> int32 with the host's instruction when the input is
+ * zero or normal and fits (|a| < 2^31): no flag but inexact can arise.
+ */
+static inline bool xps_f32_to_i32(float32 a, bool trunc, int32_t *out,
+                                  float_status *s)
+{
+    uint32_t bits = float32_val(a);
+    uint32_t e = (bits >> 23) & 0xff;
+    union { uint32_t u; float f; } x = { .u = bits };
+    int32_t i;
+
+    if (e >= 158 || (e == 0 && (bits << 1))) {
+        return false;
+    }
+    if (trunc) {
+        i = _mm_cvttss_si32(_mm_set_ss(x.f));
+    } else if (s->float_rounding_mode == float_round_nearest_even) {
+        i = _mm_cvtss_si32(_mm_set_ss(x.f)); /* host MXCSR: nearest */
+    } else {
+        return false;
+    }
+    if ((float)i != x.f) {
+        float_raise(float_flag_inexact, s);
+    }
+    *out = i;
+    return true;
+}
+#endif
+
 int32_t float32_to_int32(float32 a, float_status *s)
 {
+#ifdef __PROSPERO__
+    int32_t r;
+    if (xps_f32_to_i32(a, false, &r, s)) {
+        return r;
+    }
+#endif
     return float32_to_int32_scalbn(a, s->float_rounding_mode, 0, s);
 }
 
@@ -3437,6 +3475,12 @@ int16_t float32_to_int16_round_to_zero(float32 a, float_status *s)
 
 int32_t float32_to_int32_round_to_zero(float32 a, float_status *s)
 {
+#ifdef __PROSPERO__
+    int32_t r;
+    if (xps_f32_to_i32(a, true, &r, s)) {
+        return r;
+    }
+#endif
     return float32_to_int32_scalbn(a, float_round_to_zero, 0, s);
 }
 
@@ -3986,6 +4030,13 @@ float32 int64_to_float32(int64_t a, float_status *status)
 
 float32 int32_to_float32(int32_t a, float_status *status)
 {
+#ifdef __PROSPERO__
+    /* XPSemu: exact (no flags) for |a| <= 2^24: the host's conversion. */
+    if (a >= -(1 << 24) && a <= (1 << 24)) {
+        union { float f; uint32_t u; } x = { .f = (float)a };
+        return make_float32(x.u);
+    }
+#endif
     return int64_to_float32_scalbn(a, 0, status);
 }
 
