+#ifdef __PROSPERO__
+/*
+ * XPSemu: MMX punpck{l,h}{bw,wd,dq} as a few 64-bit ops in the translated
+ * code instead of a helper call (Fable runs them constantly).
+ */
+static void xps_spread(TCGv_i64 x, int size)
+{
+    /* The low 32 bits' elements, each to the bottom of a lane twice as wide */
+    TCGv_i64 t = tcg_temp_new_i64();
+
+    tcg_gen_ext32u_i64(x, x);
+    tcg_gen_shli_i64(t, x, 16);
+    tcg_gen_or_i64(x, x, t);
+    tcg_gen_andi_i64(x, x, 0x0000ffff0000ffffull);
+    if (size == 8) {
+        tcg_gen_shli_i64(t, x, 8);
+        tcg_gen_or_i64(x, x, t);
+        tcg_gen_andi_i64(x, x, 0x00ff00ff00ff00ffull);
+    }
+}
+
+static bool xps_gen_punpck_mmx(DisasContext *s, X86DecodedInsn *decode,
+                               bool high, int size)
+{
+    TCGv_i64 a, b;
+
+    if (s->prefix & (PREFIX_DATA | PREFIX_VEX)) {
+        return false; /* XMM/YMM, or VEX (illegal for MMX): the usual way */
+    }
+    a = tcg_temp_new_i64();
+    b = tcg_temp_new_i64();
+    tcg_gen_ld_i64(a, tcg_env, vector_reg_offset(&decode->op[1]));
+    tcg_gen_ld_i64(b, tcg_env, vector_reg_offset(&decode->op[2]));
+    if (high) {
+        tcg_gen_shri_i64(a, a, 32);
+        tcg_gen_shri_i64(b, b, 32);
+    }
+    if (size == 32) {
+        tcg_gen_deposit_i64(a, a, b, 32, 32);
+    } else {
+        xps_spread(a, size);
+        xps_spread(b, size);
+        tcg_gen_shli_i64(b, b, size);
+        tcg_gen_or_i64(a, a, b);
+    }
+    tcg_gen_st_i64(a, tcg_env, vector_reg_offset(&decode->op[0]));
+    return true;
+}
+
+#define XPS_PUNPCK(uname, lname, high, size)                                       \
+static void gen_##uname(DisasContext *s, X86DecodedInsn *decode)                   \
+{                                                                                  \
+    if (!xps_gen_punpck_mmx(s, decode, high, size)) {                              \
+        gen_binary_int_sse(s, decode,                                              \
+                              gen_helper_##lname##_mmx,                            \
+                              gen_helper_##lname##_xmm,                            \
+                              gen_helper_##lname##_ymm);                           \
+    }                                                                              \
+}
+#else
+#define XPS_PUNPCK(uname, lname, high, size) BINARY_INT_MMX(uname, lname)
+#endif
+XPS_PUNPCK(PUNPCKLBW,  punpcklbw, false, 8)
+XPS_PUNPCK(PUNPCKLWD,  punpcklwd, false, 16)
+XPS_PUNPCK(PUNPCKLDQ,  punpckldq, false, 32)
 BINARY_INT_MMX(PACKSSWB,   packsswb)
 BINARY_INT_MMX(PACKUSWB,   packuswb)
